# === App ===
DEBUG=true

# === Database ===
DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach
DATABASE_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === LLM Gateway: Primary (Google Gemini) ===
PRIMARY_PROVIDER=google
PRIMARY_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=your-google-api-key-here

# === LLM Gateway: Secondary (OpenAI-compatible) ===
SECONDARY_PROVIDER=openai_compat
SECONDARY_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1

# === LLM Gateway: Local fallback ===
LOCAL_PROVIDER=openai_compat
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2

# === LLM Gateway: Behavior ===
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_RETRIES=3
